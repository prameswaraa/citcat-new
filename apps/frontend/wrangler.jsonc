{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kirimchat-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // Disable keep_names to fix __name is not defined error
  "keep_names": false,

  // Static assets binding
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  // Custom domains
  "routes": [
    { "pattern": "citcat.id/*", "zone_name": "citcat.id" },
    { "pattern": "www.citcat.id/*", "zone_name": "citcat.id" }
  ],

  // Environment variables
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.citcat.id",
    "NEXT_PUBLIC_APP_URL": "https://citcat.id",
    "NEXT_PUBLIC_APP_NAME": "Citcat"
  }
}
