# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.production and fill in your production values
# NEVER commit .env.production to version control

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require&channel_binding=require"

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV="production"
PORT=3005

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION"
BETTER_AUTH_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION"

# Security settings
BCRYPT_ROUNDS=12
JWT_EXPIRES_IN="24h"
TWO_FACTOR_ISSUER="METAWA Platform"

# ============================================
# META/WHATSAPP CONFIGURATION
# ============================================
# Get these from Meta App Dashboard: https://developers.facebook.com/apps/
META_APP_ID="your-production-meta-app-id"
META_APP_SECRET="your-production-meta-app-secret"
META_CONFIG_ID="your-production-embedded-signup-config-id"

# META_ACCESS_TOKEN is REMOVED - Each WABA uses its own OAuth token stored in WhatsAppAccount table
# Per Meta policy, each WABA must use its own token obtained via Embedded Signup OAuth flow
# Tokens are automatically refreshed by the system (see cron/refreshWABATokens.ts)

# WABA ID is no longer needed globally - each user has their own WABA(s)
# META_WABA_ID removed

# ============================================
# WABA EMBEDDED SIGNUP CONFIGURATION
# ============================================
# Generate encryption key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WABA_TOKEN_ENCRYPTION_KEY="CHANGE_THIS_TO_A_SECURE_32_BYTE_BASE64_KEY"

# OAuth Configuration
# Note: This should point to FRONTEND URL, not backend. Meta redirects here after OAuth.
OAUTH_REDIRECT_URI="https://yourdomain.com/waba/callback"

# ============================================
# WEBHOOK CONFIGURATION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_VERIFY_TOKEN="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING"
META_VERIFY_TOKEN="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING"

# Base URL for webhook callbacks (must be HTTPS in production)
WEBHOOK_BASE_URL="https://api.yourdomain.com"

# Public URL for media links
PUBLIC_URL="https://api.yourdomain.com"

# ============================================
# EMAIL CONFIGURATION
# ============================================
# For sending notifications (token refresh failures, quality rating drops, etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-production-email@yourdomain.com"
SMTP_PASS="your-production-email-app-password"

# ============================================
# REDIS CONFIGURATION (Optional but recommended)
# ============================================
# For caching and session management
REDIS_URL="redis://your-redis-host:6379"
# For Redis with authentication:
# REDIS_URL="redis://:password@your-redis-host:6379"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=10485760

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL="info"
# Options: error, warn, info, http, verbose, debug, silly

# ============================================
# MONITORING & METRICS (Optional)
# ============================================
# Uncomment if using monitoring services
# SENTRY_DSN="your-sentry-dsn"
# NEW_RELIC_LICENSE_KEY="your-new-relic-key"
# DATADOG_API_KEY="your-datadog-api-key"
