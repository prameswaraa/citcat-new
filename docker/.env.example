# ============================================================
# KirimChat Environment Configuration
# Generated by install.sh - DO NOT SHARE THIS FILE
# ============================================================

# ------------------------------------------------------------
# REQUIRED: Domain Configuration
# ------------------------------------------------------------
DOMAIN=app.example.com
SSL_EMAIL=admin@example.com

# ------------------------------------------------------------
# REQUIRED: Database Configuration
# ------------------------------------------------------------
DB_NAME=kirimchat
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_GENERATED_BY_INSTALLER

# ------------------------------------------------------------
# REQUIRED: Redis Configuration
# ------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_GENERATED_BY_INSTALLER

# ------------------------------------------------------------
# REQUIRED: Authentication Secrets
# ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATED_BY_INSTALLER
BETTER_AUTH_SECRET=CHANGE_ME_GENERATED_BY_INSTALLER

# ------------------------------------------------------------
# REQUIRED: WhatsApp Configuration
# ------------------------------------------------------------
WEBHOOK_VERIFY_TOKEN=CHANGE_ME_GENERATED_BY_INSTALLER
WABA_TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATED_BY_INSTALLER

# ------------------------------------------------------------
# OPTIONAL: SMTP Email Configuration
# Configure via admin dashboard or set here
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=KirimChat
SMTP_SECURE=false

# ------------------------------------------------------------
# OPTIONAL: Meta/WhatsApp Business API
# Get these from Facebook Developer Console
# ------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_CONFIG_ID=

# ------------------------------------------------------------
# OPTIONAL: Google OAuth
# Get these from Google Cloud Console
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# OPTIONAL: Instagram Integration
# ------------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------
# OPTIONAL: Payment Gateway (Duitku)
# ------------------------------------------------------------
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_CALLBACK_URL=

# ------------------------------------------------------------
# OPTIONAL: AI Features (OpenAI)
# ------------------------------------------------------------
OPENAI_API_KEY=
